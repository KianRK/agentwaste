# GPU image: needs the NVIDIA Container Toolkit on the host. Run with --gpus all.
# CUDA major version must match the onnxruntime-gpu build (1.31 = CUDA 13 + cuDNN 9).
FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /srv

COPY requirements-api.txt .
RUN grep -v '^onnxruntime' requirements-api.txt > req-gpu.txt \
    && echo 'onnxruntime-gpu==1.31.0' >> req-gpu.txt \
    && pip install --no-cache-dir -r req-gpu.txt

COPY app/ app/

EXPOSE 8000
# one worker: each worker would load its own copy of the model onto the 8 GB GPU
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
