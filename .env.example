# Copy to .env and adjust.

# Host folder with the images the agent may classify (mounted read-only into the MCP server)
IMAGE_DIR=/home/kian/waste-images

# Your user/group id (run `id -u` / `id -g`) so the MCP server can read your files
UID=1000
GID=1000

# ---- LLM (llama.cpp)
# Hugging Face repo:quant, downloaded once into ./models
LLM_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
LLM_ALIAS=local
# Context window in tokens. Lower to 8192 if llama-server runs out of memory at startup.
LLM_CTX=12288
# KV cache precision: q8_0 (default) or f16 (more accurate, twice the memory)
LLM_KV_TYPE=q8_0
LLAMA_IMAGE_TAG=server-cuda13

# ---- Classifier
# Hard cap for ONNX Runtime's GPU memory arena
CLASSIFIER_GPU_MB=768
# Images per request from MCP server to classifier (also the warmup batch size)
CHUNK_SIZE=16
